# Copie este arquivo para .env e peça ao administrador institucional adulto
# e autorizado para preencher os valores no servidor.
# NUNCA publique o arquivo .env nem exponha a chave no HTML/JavaScript.

FLASK_ENV=production
SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Insira aqui a chave criada no Google AI Studio / projeto Gemini API.
GEMINI_API_KEY=cole-a-chave-aqui
GEMINI_MODEL=gemini-3.5-flash

# Configuração otimizada para apostilas no limite de requisição do PythonAnywhere.
GEMINI_APOSTILA_MODEL=gemini-3.5-flash-lite
GEMINI_AVALIACAO_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=180
APOSTILA_MAX_INPUT_CHARS=160000
AVALIACAO_MAX_INPUT_CHARS=240000

# Limites de segurança (megabytes).
MAX_REQUEST_MB=30
MAX_FILE_MB=15
MAX_FILES_PER_REQUEST=20

# Identidade visual/institucional dos DOCX.
INSTITUTION_NAME=Nome da Instituição de Ensino Superior
INSTITUTION_UNIT=Pró-Reitoria Acadêmica / Coordenação do Curso
INSTITUTION_WEBSITE=https://www.exemplo.edu.br
INSTITUTION_ADDRESS=
INSTITUTION_FOOTER=
PRIVACY_CONTACT_EMAIL=privacidade@exemplo.edu.br

# Use "paid" se o projeto Gemini estiver vinculado a faturamento ativo.
# Em quota gratuita, o Google informa que entradas/saídas podem ser usadas
# para melhoria de produtos e analisadas por revisores humanos.
GEMINI_DATA_MODE=unpaid

# Produção: false. Só use true em testes locais e sem dados reais.
USE_FAKE_GEMINI=false
